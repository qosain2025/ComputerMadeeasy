# -----------------------------------------------------------------------------
# Computer Basics Made Simple - Environment Configuration Example
# No secret keys are required. All variables are public client-safe options.
# -----------------------------------------------------------------------------

# The production URL for canonical links, sitemaps, and OpenGraph cards.
# Set this in your Vercel Project Settings or local .env.local file.
# Defaults to https://computerbasics.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=https://computerbasics.vercel.app

# Optional Google Search Console HTML tag verification token
# (e.g. google-site-verification=abc123xyz456)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
